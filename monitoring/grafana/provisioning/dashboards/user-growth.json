{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "rate(user_registrations_total[1d])",
          "legendFormat": "registrations/day",
          "refId": "A"
        }
      ],
      "title": "User Registrations / sec",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "rate(profile_creation_total{profile_type=\"user\"}[1d])",
          "legendFormat": "user profile",
          "refId": "A"
        },
        {
          "expr": "rate(profile_creation_total{profile_type=\"specialist\"}[1d])",
          "legendFormat": "specialist profile",
          "refId": "B"
        }
      ],
      "title": "Profile Creations / sec",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "user_registrations_total",
          "legendFormat": "registrations total",
          "refId": "A"
        }
      ],
      "title": "Cumulative User Registrations",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (profile_type) (profile_creation_total)",
          "legendFormat": "{{profile_type}}",
          "refId": "A"
        }
      ],
      "title": "Profile Distribution",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["users", "growth"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
