{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "count(container_last_seen{job=\"cadvisor\",container_label_com_docker_compose_service!=\"\"})",
          "refId": "A"
        }
      ],
      "title": "Observed Containers",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "up{job=\"cadvisor\"}",
          "legendFormat": "cAdvisor",
          "refId": "A"
        }
      ],
      "title": "cAdvisor Availability",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",image!=\"\"}[5m])) * 100)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 Containers by CPU %",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "topk(10, sum by (name) (container_memory_usage_bytes{job=\"cadvisor\",image!=\"\"}))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 Containers by Memory",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["docker", "containers"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Docker Overview",
  "uid": "docker-overview",
  "version": 1
}
