DEBUG={{ debug }}
SECRET_KEY={{ secret_key }}
{% if env_type == 'staging' %}
FRONTEND_URL={{ frontend_url | default('https://' ~ site_domain) }}
{% else %}
FRONTEND_URL={{ frontend_url | default('http://localhost:3000') }}
{% endif %}

# Database configuration
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_HOST={{ postgres_host if env_type == 'staging' else 'db' }}
POSTGRES_PORT=5432

# Cache / Redis configuration (Додано)
REDIS_HOST=redis
REDIS_PORT=6379

# Django / Security configuration
{% if env_type == 'staging' %}
ALLOWED_HOSTS={{ allowed_hosts | default(site_domain) }}
CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins | default('https://' ~ site_domain) }}
{% else %}
ALLOWED_HOSTS={{ allowed_hosts | default('localhost,127.0.0.1,' ~ site_domain) }}
CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins | default('http://localhost:3000,https://' ~ site_domain) }}
{% endif %}

# Celery configuration
CELERY_BROKER_URL={{ celery_broker_url }}
CELERY_RESULT_BACKEND={{ celery_result_backend }}

# Email configuration
EMAIL_HOST={{ email_host }}
EMAIL_PORT={{ email_port }}
EMAIL_USE_TLS={{ email_use_tls | default('true') }}
EMAIL_HOST_USER={{ email_host_user }}
EMAIL_HOST_PASSWORD={{ email_host_password }}
DEFAULT_FROM_EMAIL={{ default_from_email | default('') }}

# AWS / S3 Storage configuration
USE_S3={{ use_s3 | default('false') }}
AWS_ACCESS_KEY_ID={{ aws_access_key_id | default('') }}
AWS_SECRET_ACCESS_KEY={{ aws_secret_access_key | default('') }}
AWS_STORAGE_BUCKET_NAME={{ aws_storage_bucket_name | default('') }}
AWS_S3_REGION_NAME={{ aws_s3_region_name | default('us-east-1') }}

# Application Admin Credentials
ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ admin_password }}
ADMIN_USERNAME={{ admin_username }}

# Monitoring & Alerting (Додано/Виправлено)
GRAFANA_PASSWORD={{ grafana_password }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_password }}
SLACK_WEBHOOK_URL={{ slack_webhook_url | default('') }}
